{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ankush1982/ai-secure-by-design/schemas/regime.schema.json",
  "title": "Regime catalogue (regimes/*.yaml)",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "scope",
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "0.2"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "publishedDate": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "implementation",
          "severity"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "section": {
            "type": "string",
            "description": "Statute section, e.g. \u00a76 (DPDP)."
          },
          "annexA": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^A\\.[0-9]+\\.[0-9]+$"
            },
            "description": "ISO 27001:2022 Annex A control IDs."
          },
          "practices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "NIST SSDF practice IDs."
          },
          "description": {
            "type": "string"
          },
          "implementation": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Short name."
          },
          "family": {
            "type": "string",
            "description": "Control family (wiki)."
          },
          "tier": {
            "type": "string",
            "description": "Baseline or Advanced (wiki)."
          },
          "evidence": {
            "type": "string",
            "description": "Evidence an auditor asks for (wiki)."
          },
          "auditTest": {
            "type": "string",
            "description": "How an auditor tests the control (wiki)."
          },
          "owner": {
            "type": "string",
            "description": "Usual control owner (wiki)."
          },
          "reviewFrequency": {
            "type": "string",
            "description": "How often to review the control (wiki)."
          },
          "url": {
            "type": "string",
            "description": "Page for this control."
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Risk register IDs (wiki)."
          },
          "testCases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Test cases that test this control (wiki)."
          },
          "severity": {
            "$ref": "#/definitions/severity"
          }
        }
      }
    }
  },
  "definitions": {
    "severity": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    }
  }
}
