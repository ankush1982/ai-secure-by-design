{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "build/tsc",
    "rootDir": "mcp-server/src",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["mcp-server/src/**/*.ts"]
}
