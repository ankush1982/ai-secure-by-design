{
  "name": "ai-secure-by-design",
  "version": "0.2.0-dev",
  "description": "Deterministic secure-by-design / privacy-by-design checks with CLI, SARIF output, MCP server and git/CI adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankush1982/ai-secure-by-design"
  },
  "bin": {
    "sbd": "dist/sbd.mjs",
    "sbd-mcp": "dist/sbd-mcp.mjs"
  },
  "files": [
    "dist/",
    "regimes/",
    "rules/",
    "schemas/",
    "templates/",
    "hooks/",
    "instructions/"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node scripts/bundle.mjs",
    "test": "tsc --noEmit -p tsconfig.json && node scripts/bundle.mjs --check && node --test mcp-server/test/engine.test.mjs mcp-server/test/mcp.test.mjs",
    "gen:instructions": "node scripts/gen-instructions.mjs",
    "check:instructions": "node scripts/gen-instructions.mjs --check"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "20.19.43",
    "ajv": "8.20.0",
    "esbuild": "0.25.12",
    "typescript": "5.8.3",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
